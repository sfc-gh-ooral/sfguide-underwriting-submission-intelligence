# Live mode. Copy to .env.local (git-ignored) after running sql/setup.sql.
# Without it the app runs in Sample mode on the bundled synthetic data.

# Account identifier in <org>-<account> form, and the user that ran setup.sql
# (setup grants USI_DEMO_ROLE to that user).
SNOWFLAKE_ACCOUNT=<orgname>-<account_name>
SNOWFLAKE_USERNAME=<YOUR_USER>

# Key-pair authentication (recommended). Keep the key outside the repository.
#   openssl genrsa 2048 | openssl pkcs8 -topk8 -inform PEM -out ~/.snowflake/keys/usi_rsa_key.p8 -nocrypt
#   openssl rsa -in ~/.snowflake/keys/usi_rsa_key.p8 -pubout
#   ALTER USER <YOUR_USER> SET RSA_PUBLIC_KEY_2 = '<public key body>';
SNOWFLAKE_PRIVATE_KEY_PATH=/absolute/path/to/usi_rsa_key.p8

# Optional overrides (defaults shown)
# SNOWFLAKE_ROLE=USI_DEMO_ROLE
# SNOWFLAKE_WAREHOUSE=USI_WH
# SNOWFLAKE_DATABASE=UNDERWRITING_SUBMISSION_DEMO
# SNOWFLAKE_AGENT_NAME=UNDERWRITING_SUBMISSION_DEMO.UW.SUBMISSION_ASSISTANT
# SNOWFLAKE_COMPLETE_MODEL=claude-sonnet-4-5
